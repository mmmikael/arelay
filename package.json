{
	"name": "@arelay/app",
	"version": "0.1.0",
	"private": true,
	"description": "Where your AI agents ask permission: a human approval gate and end-to-end encrypted inbox for agent output.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mmmikael/arelay.git"
	},
	"bugs": {
		"url": "https://github.com/mmmikael/arelay/issues"
	},
	"homepage": "https://arelay.app",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "node scripts/start.mjs",
		"dev": "vite dev",
		"build:packages": "npm run build -w @arelay/core && npm run build -w @arelay/client",
		"build": "npm run build:packages && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run build:packages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run build:packages && vitest run",
		"test:watch": "npm run build:packages && vitest",
		"db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node scripts/migrate-db.mjs",
		"db:migrate:local": "node --env-file=.env scripts/migrate-db.mjs",
		"db:smoke": "node --import tsx scripts/smoke-db-migrations.ts",
		"db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/postcss": "^4.1.13",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22.14.1",
		"@types/nodemailer": "^8.0.0",
		"bits-ui": "0.22.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"pino-pretty": "^13.1.3",
		"postcss": "^8.5.3",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-eslint-parser": "^1.8.1",
		"tailwind-merge": "^3.2.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.19.4",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.67.0",
		"vite": "^6.2.5",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@arelay/client": "^0.1.0",
		"@aws-sdk/client-s3": "^3.700.0",
		"@aws-sdk/s3-request-presigner": "^3.700.0",
		"@lucide/svelte": "^0.511.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.2",
		"marked": "^15.0.12",
		"nodemailer": "^8.0.10",
		"pino": "^10.3.1",
		"postgres": "^3.4.7"
	}
}
