{
	"name": "@arelay/core",
	"version": "0.1.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "Isomorphic end-to-end encryption envelope format shared by Agent Relay's delivery SDK, reader, and portal.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mmmikael/arelay.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/mmmikael/arelay/issues"
	},
	"homepage": "https://arelay.app",
	"keywords": [
		"agent",
		"ai",
		"e2ee",
		"encryption",
		"envelope",
		"ecdh",
		"webcrypto"
	],
	"devDependencies": {
		"@types/node": "^22.14.1",
		"typescript": "^5.8.0",
		"vitest": "^3.2.4"
	}
}
