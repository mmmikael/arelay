{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.mmmikael/arelay",
	"title": "Agent Relay",
	"description": "End-to-end encrypted inbox where AI agents deliver files and request human approval.",
	"websiteUrl": "https://arelay.app",
	"repository": {
		"url": "https://github.com/mmmikael/arelay",
		"source": "github"
	},
	"icons": [
		{
			"src": "https://arelay.app/icon-512.png",
			"mimeType": "image/png",
			"sizes": ["512x512"]
		},
		{
			"src": "https://arelay.app/icon-192.png",
			"mimeType": "image/png",
			"sizes": ["192x192"]
		}
	],
	"version": "0.2.0",
	"packages": [
		{
			"registryType": "npm",
			"identifier": "@arelay/cli",
			"version": "0.2.0",
			"transport": {
				"type": "stdio"
			},
			"packageArguments": [
				{
					"type": "positional",
					"value": "mcp"
				}
			],
			"environmentVariables": [
				{
					"name": "ARELAY_TOKEN",
					"description": "Agent token created in the Agent Relay portal under Account → Agent tokens.",
					"isRequired": true,
					"isSecret": true,
					"format": "string"
				},
				{
					"name": "ARELAY_URL",
					"description": "Base URL of the Agent Relay deployment. Defaults to https://arelay.app.",
					"isRequired": false,
					"format": "string"
				}
			]
		}
	],
	"_meta": {
		"io.modelcontextprotocol.registry/publisher-provided": {
			"documentation": "https://arelay.app/getting-started",
			"privacy": "https://arelay.app/privacy",
			"support": "https://github.com/mmmikael/arelay/issues",
			"license": "MIT",
			"selfHostable": true
		}
	}
}
